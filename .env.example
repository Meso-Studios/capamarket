# Copy to .env.local. The site itself needs none of this: it uses the public Supabase
# URL + publishable key baked into src/lib/supabase.ts (override with the NEXT_PUBLIC_ vars).

# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...
# NEXT_PUBLIC_BASE_PATH=        # set automatically in CI to /<repo>

# Scripts only (npm run db:migrate / db:seed / db:clear-demo). Never commit real values.
# Supabase session pooler; URL-encode special characters in the password (# -> %23, & -> %26).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Accounts created by `npm run db:seed`
ADMIN_EMAIL=admin@capamarket.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TEST_PASSWORD_ALICE=
TEST_PASSWORD_BOB=
TEST_PASSWORD_CAROL=
TEST_PASSWORD_DAVE=
