# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase Postgres. Local dev / migrations: session pooler (port 5432).
# On Vercel use the transaction pooler (port 6543) — serverless opens many short connections.
# URL-encode special characters in the password (# -> %23, & -> %26).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Public URL of the app (Google OAuth redirect + links in emails). e.g. https://capamarket.vercel.app
APP_URL=http://localhost:3000

# Google sign-in. Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email for admin 2FA codes and report notifications (required in production).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail address>, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Admin email 2-step verification: off unless set to "on".
ADMIN_2FA=
# Inbox that receives admin login codes (when ADMIN_2FA=on) and report alerts.
ADMIN_NOTIFY_EMAIL=pittsburghtornadoes@gmail.com

# Only used by `npm run db:seed` (local).
ADMIN_EMAIL=admin@capamarket.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
